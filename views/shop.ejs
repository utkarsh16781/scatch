<%- include("partials/header") %>

<div class="page-head">
  <h1>Shop</h1>
  <p>Signed in as <%= user.fullname %></p>
</div>

<% if (products.length === 0) { %>
  <div class="empty">
    <h2>No products yet</h2>
    <p>The owner adds products from the owner panel. Check back soon.</p>
  </div>
<% } else { %>
  <div class="grid">
    <% products.forEach(function (p) { %>
      <% var shown = p.price - (p.discount || 0); %>
      <article class="card" style="--bg: <%= p.bgcolor || '#dfe3e8' %>; --panel: <%= p.panelcolor || '#ffffff' %>; --text: <%= p.textcolor || '#15191e' %>;">
        <div class="card-art">
          <% if (p.image) { %>
            <img src="<%= p.image %>" alt="<%= p.name %>">
          <% } else { %>
            <span class="noimg">No image</span>
          <% } %>
        </div>
        <div class="card-body">
          <div>
            <h2><%= p.name %></h2>
            <p class="price">
              <strong>₹<%= shown.toLocaleString("en-IN") %></strong>
              <% if (p.discount > 0) { %><s>₹<%= p.price.toLocaleString("en-IN") %></s><% } %>
            </p>
          </div>
          <form action="/cart/add/<%= p._id %>" method="post">
            <button class="round" type="submit" aria-label="Add <%= p.name %> to cart">+</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include("partials/footer") %>
